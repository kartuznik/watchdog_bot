# ==========================================
# TELEGRAM
# ==========================================
# Docs: https://core.telegram.org/bots/tutorial
TELEGRAM_BOT_TOKEN=
OWNER_ID=
TELEGRAM_ALERT_CHAT_ID=
# Soft-deleted / usage retention window (days).
DATA_RETENTION_DAYS=90
# Optional: block soft-deleted users from the bot (default off).
# SOFT_DELETE_GATE=false
# Optional comma-separated feature flags override.
# ENABLED_MODULES=self_diagnostics,background_worker,web_search

# ==========================================
# LLM PROVIDERS
# ==========================================
# Docs: https://platform.openai.com/docs
# Docs: https://api-docs.deepseek.com/
# Allowed LLM_PROVIDER: openai | deepseek (foreign providers only; no YandexGPT).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=gpt-4o-mini

# ==========================================
# SEARCH (Tavily)
# ==========================================
# Docs: https://docs.tavily.com/
TAVILY_API_KEY=
TAVILY_FRESHNESS_DAYS=2
TAVILY_NEWS_TOPIC=news

# ==========================================
# WEB ADMIN PANEL
# ==========================================
ADMIN_PASSWORD=change-me

# ==========================================
# DATABASE & LOGS
# ==========================================
REDIS_URL=redis://redis:6379
AGENT_DB_PATH=./data/agent_memory.db

# ==========================================
# MONITORING
# ==========================================
METRICS_PORT=8001
GRAFANA_ADMIN_PASSWORD=admin123
