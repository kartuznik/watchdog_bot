# ------------------------------
# Telegram bot
# ------------------------------
# Token from BotFather
# ВАЖНО: используйте УНИКАЛЬНЫЙ токен для этого бота.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
# Grafana Telegram alerts (defaults to OWNER_ID when unset in compose).
TELEGRAM_ALERT_CHAT_ID=
ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=admin123
METRICS_PORT=8001
REDIS_URL=redis://redis:6379
AGENT_DB_PATH=./data/agent_memory.db
# Soft-deleted / usage retention window (days).
DATA_RETENTION_DAYS=90
# Optional: block soft-deleted users from the bot (default off).
# SOFT_DELETE_GATE=false

# Optional comma-separated feature flags override.
# Default in config.py: self_diagnostics,background_worker,web_search
# ENABLED_MODULES=self_diagnostics,background_worker,web_search

# ------------------------------
# LLM provider switch
# Allowed: openai | deepseek
# gpt-4o-mini is recommended for daily/dev cost control.
# ------------------------------
LLM_PROVIDER=openai

# ------------------------------
# OpenAI configuration
# Default endpoint: https://api.openai.com/v1
# ------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------
# DeepSeek configuration (optional)
# Get API key at: https://platform.deepseek.com
# Default endpoint: https://api.deepseek.com
# ------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------
# Tavily Web Search
# ------------------------------
TAVILY_API_KEY=

# ------------------------------
# Model name
# openai default: gpt-4o-mini
# deepseek default: deepseek-chat
# ------------------------------
MODEL_NAME=gpt-4o-mini
